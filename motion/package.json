{
  "name": "ia-studio-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Motion graphics estilo 'Spark' (blur, glass, degradados, rebotes) hechos con Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render SparkPromo out/spark-promo.mp4",
    "render:prompt": "remotion render PromptPromo out/prompt-promo.mp4",
    "render:reel": "remotion render PromptReel out/prompt-reel-vertical.mp4",
    "still": "remotion still SparkPromo out/frame.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@remotion/cli": "^4.0.533",
    "@remotion/motion-blur": "^4.0.533",
    "@remotion/noise": "^4.0.533",
    "@remotion/paths": "^4.0.533",
    "@remotion/shapes": "^4.0.533",
    "@remotion/transitions": "^4.0.533",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.533"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
